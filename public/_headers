# Long-lived caching for immutable static files. Build assets already carry
# hashed filenames; these are the hand-placed ones.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/og-image.png
  Cache-Control: public, max-age=604800

/favicon.png
  Cache-Control: public, max-age=604800

/robots.txt
  Cache-Control: public, max-age=3600

/llms.txt
  Cache-Control: public, max-age=3600

/.well-known/*
  Cache-Control: public, max-age=3600

# Prerendered HTML pages: these are static files generated at build time, so a
# short edge cache is safe and cuts the ~1.2s TTFB (the dominant LCP cost) for
# repeat visits down to an edge hit. Content only changes on rebuild.
/library
  Cache-Control: public, max-age=60, s-maxage=600, stale-while-revalidate=86400

/collections
  Cache-Control: public, max-age=60, s-maxage=600, stale-while-revalidate=86400

/discover
  Cache-Control: public, max-age=60, s-maxage=600, stale-while-revalidate=86400

/about
  Cache-Control: public, max-age=60, s-maxage=600, stale-while-revalidate=86400

/licenses
  Cache-Control: public, max-age=60, s-maxage=600, stale-while-revalidate=86400

/developers
  Cache-Control: public, max-age=60, s-maxage=600, stale-while-revalidate=86400

/emoji
  Cache-Control: public, max-age=60, s-maxage=600, stale-while-revalidate=86400

/games/*
  Cache-Control: public, max-age=60, s-maxage=600, stale-while-revalidate=86400

/collections/*
  Cache-Control: public, max-age=60, s-maxage=600, stale-while-revalidate=86400

/
  Cache-Control: public, max-age=60, s-maxage=600, stale-while-revalidate=86400
