# Long-lived caching for immutable static files. Build assets already carry
# hashed filenames; these are the hand-placed ones.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/og-image.png
  Cache-Control: public, max-age=604800

/favicon.png
  Cache-Control: public, max-age=604800

/robots.txt
  Cache-Control: public, max-age=3600

/llms.txt
  Cache-Control: public, max-age=3600

/.well-known/*
  Cache-Control: public, max-age=3600
