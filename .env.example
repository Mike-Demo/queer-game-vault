# QueerCade environment variables — PLACEHOLDERS ONLY.
# Never commit a file containing real values. Copy to `.env` locally.
#
# --- Public backend config (safe in the browser bundle) ---
# These are publishable values shipped to every visitor. Data is protected by
# row level security and auth, not by hiding these.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# Server-side mirrors of the same public values
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"
SUPABASE_PROJECT_ID="your-project-ref"

# --- Private secrets: DO NOT put these in any .env file ---
# They live in the Lovable Cloud secret vault and are injected at runtime.
# Listed here for documentation only.
#
# SUPABASE_SERVICE_ROLE_KEY   full-access backend key (bypasses row level security)
# SUPABASE_ANON_KEY           legacy anon key used by server code
# SUPABASE_DB_URL             direct database connection string
# SANITY_PROJECT_ID           content project id
# SANITY_DATASET              content dataset name
# SANITY_API_WRITE_TOKEN      content write token
# TWITCH_CLIENT_ID            IGDB / Twitch app id
# TWITCH_CLIENT_SECRET        IGDB / Twitch app secret
# LOVABLE_API_KEY             Lovable AI gateway key
# LOVABLE_CRON_SECRET         shared secret for scheduled jobs
# FIRECRAWL_API_KEY           managed by the Firecrawl connector
# GOOGLE_SEARCH_CONSOLE_API_KEY  managed by the Search Console connector
